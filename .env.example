# FinIntern Hub 环境变量配置模板
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 修改所有 TOKEN 为随机字符串（建议使用 openssl rand -base64 32 生成）
# 3. 根据需要配置其他选项
# 4. 重启应用使配置生效

# ============================================
# 认证 Token 配置（重要：必须修改为随机字符串！）
# ============================================

# 管理员 Token - 拥有最高权限，可执行所有操作
# 建议生成方式：openssl rand -base64 32
# 注意：此 Token 具有完全控制权，请妥善保管，不要泄露给他人
ADMIN_TOKEN=your_admin_token_here_change_me

# 操作员 Token - 拥有常规操作权限，可管理职位信息
# 建议生成方式：openssl rand -base64 32
# 注意：用于日常管理操作，权限低于管理员
OPERATOR_TOKEN=your_operator_token_here_change_me

# 查看者 Token - 仅拥有查看权限，无法修改数据
# 建议生成方式：openssl rand -base64 32
# 注意：用于只读访问，适合普通用户或展示用途
VIEWER_TOKEN=your_viewer_token_here_change_me

# 认证盐值 - 用于加密会话等敏感数据
# 要求：至少32位随机字符串
# 建议生成方式：openssl rand -base64 48
# 警告：一旦设置并投入使用，请勿随意更改，否则会导致已登录用户会话失效
AUTH_SALT=your_auth_salt_here_must_be_at_least_32_characters_long

# ============================================
# 数据库配置
# ============================================

# SQLite 数据库文件路径
# 默认路径：/app/data/jobs.db
# 注意：确保该路径所在目录存在且有写入权限
# Docker 环境下建议使用容器内路径
DATABASE_PATH=/app/data/jobs.db

# ============================================
# 会话配置
# ============================================

# 会话超时时间（小时）
# 用户登录后在此时间内无操作将自动登出
# 默认：24 小时
# 建议生产环境设置为 8-12 小时，开发环境可设置更长
SESSION_TIMEOUT_HOURS=24

# 最大登录尝试次数
# 连续失败达到此次数后将锁定账户
# 默认：5 次
# 建议：生产环境 3-5 次，防止暴力破解
MAX_LOGIN_ATTEMPTS=5

# 登录锁定时间（分钟）
# 超过最大尝试次数后，需要等待的时间
# 默认：15 分钟
# 建议：生产环境 15-30 分钟
LOGIN_LOCKOUT_MINUTES=15

# ============================================
# AI 配置（可选）
# ============================================

# OpenAI API 密钥
# 用于 AI 辅助功能（如智能职位分析、简历匹配等）
# 如果不需要 AI 功能，可留空
# 获取方式：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI API 基础 URL
# 默认使用官方 API 地址
# 如果使用第三方代理或自建服务，请修改此地址
# 国内用户可能需要配置代理地址
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# SMTP 邮件配置（职位提醒功能）
# ============================================

# SMTP 服务器地址
# 常用邮箱 SMTP 地址：
#   QQ邮箱: smtp.qq.com
#   163邮箱: smtp.163.com
#   Gmail: smtp.gmail.com
#   阿里云企业邮箱: smtp.qiye.aliyun.com
SMTP_HOST=smtp.example.com

# SMTP 端口
# 常用端口：
#   25: 标准端口（不加密）
#   465: SSL 加密端口
#   587: TLS 加密端口（推荐）
SMTP_PORT=587

# SMTP 用户名（通常是邮箱地址）
SMTP_USER=your_email@example.com

# SMTP 密码或授权码
# 注意：QQ邮箱、163邮箱等需要使用授权码而非登录密码
# 获取方式：登录邮箱设置 -> POP3/SMTP服务 -> 生成授权码
SMTP_PASS=your_password_or_auth_code

# 是否使用安全连接
# true: 使用 SSL/TLS 加密（端口 465）
# false: 使用 STARTTLS（端口 587）
SMTP_SECURE=false

# 发件人名称
# 显示在邮件发件人栏的名称
SMTP_FROM_NAME=职位提醒

# 发件人邮箱
# 通常与 SMTP_USER 相同
SMTP_FROM_EMAIL=your_email@example.com
