# ============================================
# FinIntern Hub - 阿里云推送专用 Dockerfile
# ============================================
# 用于构建推送到阿里云 ACR 的镜像
#
# 使用方式:
#   docker compose -f docker-compose.build.yml build --no-cache finintern-next
#   ./push-image.sh -b -c
# ============================================

# 阶段1: 安装生产依赖 (包含原生模块编译)
FROM node:20-alpine AS deps
WORKDIR /app

# 安装 better-sqlite3 编译所需的工具链
RUN apk add --no-cache python3 make g++ && \
    npm config set python python3

COPY package.json package-lock.json* ./
RUN npm ci --only=production

# 阶段2: 构建 Next.js (standalone 输出模式)
FROM node:20-alpine AS builder
WORKDIR /app

ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm ci --include=dev && npm run build && rm -rf node_modules

# 阶段3: 生产镜像 (轻量级)
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# 安装运行时依赖
RUN apk add --no-cache \
    curl \
    sqlite-libs \
    && rm -rf /var/cache/apk/*

# 从构建阶段复制 Next.js standalone 输出
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

# 创建必要目录
RUN mkdir -p /app/data /app/log

VOLUME ["/app/data", "/app/log"]

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

CMD ["node", "server.js"]
