# AI服务配置
# 支持的提供商：openai, zhipu, siliconflow, deepseek, custom
AI_PROVIDER=siliconflow

# AI API密钥（必填）
# 使用智谱（zhipu）：填入智谱开放平台 API Key
# 使用硅基流动（siliconflow）：填入硅基流动 API Key
# 使用 OpenAI：填入 OpenAI API Key
AI_API_KEY=your_api_key_here

# AI服务基础URL（可选，使用默认值）
# 使用智谱时默认：https://open.bigmodel.cn/api/paas/v4
# AI_BASE_URL=https://api.siliconflow.cn/v1

# AI模型（可选，使用默认值）
# 使用智谱（zhipu）时推荐：glm-4.7-flash（支持深度思考，最大65536 tokens）
# 使用硅基流动（siliconflow）时推荐：Qwen/Qwen2.5-7B-Instruct
# AI_MODEL=glm-4.7-flash

# AI温度参数（可选，默认0.7）
# AI_TEMPERATURE=0.7

# AI最大token数（可选，默认65536）
# AI_MAX_TOKENS=65536