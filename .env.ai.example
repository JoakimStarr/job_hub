# AI服务配置
# 支持的提供商：openai, zhipu, siliconflow, deepseek, custom
AI_PROVIDER=siliconflow

# AI API密钥（必填）
AI_API_KEY=your_api_key_here

# AI服务基础URL（可选，使用默认值）
# AI_BASE_URL=https://api.siliconflow.cn/v1

# AI模型（可选，使用默认值）
# AI_MODEL=Qwen/Qwen2.5-7B-Instruct

# AI温度参数（可选，默认0.7）
# AI_TEMPERATURE=0.7

# AI最大token数（可选，默认2000）
# AI_MAX_TOKENS=2000
