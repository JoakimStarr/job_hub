# ============================================
# FinIntern Hub - 环境变量配置
# ============================================

# ===== 数据库配置 =====
DATABASE_PATH=/app/data/jobs.db

# ===== 会话配置 =====
SESSION_TIMEOUT_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ============================================
# AI 配置
# 选择方式：设置 AI_PROVIDER 为 zhipu 或 siliconflow
# ============================================
AI_PROVIDER=zhipu

# ---- 智谱 GLM（推荐）----
# 智谱 API Key 格式：{id}.{secret}
ZHIPU_API_KEY=38206a2d89f646a78418f609bd31908d.w602D6x27cu8Qt5y
# 智谱模型推荐：glm-4.7-flash（支持深度思考，最大 65536 tokens）
# ZHIPU_MODEL=glm-4.7-flash

# ---- 硅基流动（备选）----
# 使用硅基流动时，将 AI_PROVIDER 改为 siliconflow，并取消下面注释
# SILICONFLOW_API_KEY=your_siliconflow_key_here
# SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---- 通用 AI 参数 ----
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=65536